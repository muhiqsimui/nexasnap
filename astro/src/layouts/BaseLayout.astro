---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const { title = "NexaSnap", description = "Free Static API Platform" } =
  Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <ClientRouter fallback="swap" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title} — NexaSnap</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="fixed top-0 z-50 w-full px-4 pt-3 sm:pt-4">
      <nav
        class="mx-auto max-w-7xl flex items-center justify-between px-4 sm:px-6 py-2.5 sm:py-3 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl shadow-[0_8px_32px_0_rgba(0,0,0,0.37)]"
      >
        <a
          href={base}
          class="flex items-center gap-2 font-extrabold text-base sm:text-lg text-white no-underline tracking-tight group"
        >
          <div
            class="relative w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center"
          >
            <img
              src={`${base}/assets/nexasnap-logo.webp`}
              alt="NexaSnap Logo Core"
              class="w-full h-full object-contain drop-shadow-[0_0_15px_rgba(6,182,212,0.6)] animate-float transition-transform duration-300 group-hover:scale-105"
              onerror="this.style.display='none'"
            />
          </div>
          <span
            class="bg-gradient-to-r from-white to-white/70 bg-clip-text text-transparent"
            >NexaSnap</span
          >
        </a>

        <div class="flex items-center gap-4 sm:gap-6">
          <a
            href={base}
            class="text-white/70 hover:text-white no-underline text-sm font-medium transition-all duration-300 relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-cyan-400 after:transition-all hover:after:w-full"
          >
            Home
          </a>
          <a
            href={`${base}/docs`}
            class="text-white/70 hover:text-white no-underline text-sm font-medium transition-all duration-300 relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-cyan-400 after:transition-all hover:after:w-full"
          >
            Docs
          </a>

          <a
            href="https://github.com/muhiqsimui/nexasnap"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-4 sm:py-2 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 rounded-xl text-white/90 hover:text-white no-underline text-xs sm:text-sm font-medium transition-all duration-300 shadow-[inset_0_1px_1px_rgba(255,255,255,0.2)]"
          >
            <span class="hidden xs:inline">GitHub</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="currentColor"
              class="bi bi-github"
              viewBox="0 0 16 16"
            >
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
              ></path>
            </svg>
            Github
          </a>
        </div>
      </nav>
    </div>

    <main class="flex-1 w-full mx-auto">
      <slot />
    </main>

    <footer class="text-center py-8 sm:py-10 px-4 border-t border-border">
      <style>
        .hover-scale:hover {
          transform: scale(1.1);
        }
      </style>
      <a
        href="mailto:muhiqsimui@gmail.com"
        rel="sponsored"
        target="_blank"
        class="hover-scale inline-block font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-blue-100 to-cyan-300 text-sm sm:text-lg tracking-widest animate-gradient-move transition-transform duration-300 no-underline"
      >
        CONTACT DEVELOPER ✉︎
      </a>
    </footer>
  </body>
</html>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDocs, getCategories, getDocsByCategory } from "../../lib/docs";
import { url } from "../../lib/url";

const docs = getDocs();
const categories = getCategories(docs);
const base = import.meta.env.BASE_URL;
const categoryLabels: Record<string, string> = {
  crypto: "Cryptocurrency",
  market: "Market Data",
  news: "News",
};
---

<BaseLayout title="Documentation" description="NexaSnap API Documentation">
  <a href={base} class="meta" style="display: inline-block; margin-bottom: 1rem;">&larr; Back to Home</a>

  <h1>API Documentation</h1>
  <p class="description">
    All endpoints return JSON. Base URL:
    <code>https://muhiqsimui.github.io{base}</code>
  </p>

  <section>
    <h2>Base URL</h2>
    <div class="card" style="margin-bottom: 1.5rem;">
      <pre><code>https://muhiqsimui.github.io{base}/api/v1/</code></pre>
    </div>
  </section>

  {
    categories.map((cat) => {
      const catDocs = getDocsByCategory(docs, cat);
      const label = categoryLabels[cat] || cat;

      return (
        <section style="margin-bottom: 2rem;">
          <h2>{label}</h2>
          <p class="meta" style="margin-bottom: 0.75rem;">
            {catDocs.length} endpoint{catDocs.length > 1 ? "s" : ""}
          </p>
          <ul>
            {catDocs.map((doc) => (
              <li>
                <a href={url(base, `/docs/${doc.category}/${doc.slug}`)}>
                  <span class="badge badge-get">{doc.method}</span>
                  <code>{doc.endpoint}</code>
                  <span style="margin-left: auto; color: var(--text-muted); font-size: 0.85rem;">
                    {doc.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</BaseLayout>

---
import { getDocs } from "../../lib/docs";
const base = import.meta.env.BASE_URL;
const docs = getDocs();
---

<html>
  <head>
    <title>NexaSnap Docs</title>
  </head>

  <body>
    <h1>NexaSnap API Documentation</h1>

    <ul>
      {
        docs.map((doc) => (
          <li>
            <a href={`${base}docs/${doc.category}/${doc.slug}`}>{doc.title}</a>
          </li>
        ))
      }
    </ul>
  </body>
</html>

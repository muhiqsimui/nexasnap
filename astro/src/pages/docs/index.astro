---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDocs, getCategories, getDocsByCategory } from "../../lib/docs";
import { url } from "../../lib/url";

const docs = getDocs();
const categories = getCategories(docs);
const base = import.meta.env.BASE_URL;
const categoryLabels: Record<string, string> = {
  crypto: "Cryptocurrency",
  market: "Market Data",
  news: "News",
};
---

<BaseLayout title="Documentation" description="NexaSnap API Documentation">
  <div class="relative min-h-screen overflow-hidden bg-bg">
    <canvas
      id="matrixCanvas"
      class="absolute inset-0 w-full h-full pointer-events-none opacity-35 z-0"
    ></canvas>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <a
        href={base}
        class="back-link inline-flex items-center gap-2 text-slate-400 no-underline text-xs sm:text-sm font-medium mb-6 sm:mb-10 px-3 sm:px-4 py-2 bg-surface border border-border rounded-full hover:text-accent hover:border-accent transition-all"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Home
      </a>

      <header class="mb-10 sm:mb-16 relative flex flex-col gap-3 sm:gap-4">
        <div
          class="absolute -top-12 -left-5 w-44 sm:w-52 h-44 sm:h-52 bg-[radial-gradient(circle,rgba(6,182,212,0.15)_0%,rgba(0,0,0,0)_70%)] pointer-events-none"
        >
        </div>

        <div class="flex items-center gap-4 sm:gap-6 flex-wrap">
          <img
            src={`${base}/assets/nexasnap-logo.webp`}
            alt="NexaSnap Logo"
            width="70"
            height="70"
            class="w-12 sm:w-[70px] h-12 sm:h-[70px] object-contain drop-shadow-[0_0_15px_rgba(6,182,212,0.5)] animate-float"
            onerror="this.style.display='none'"
          />
          <div>
            <div class="flex items-center gap-2 sm:gap-3 mb-1">
              <span
                class="bg-accent/10 text-accent text-[0.6rem] sm:text-xs font-bold px-2 sm:px-3 py-1 rounded-full border border-accent/20 uppercase tracking-wider"
                >v1.0.0</span
              >
            </div>
            <h1
              class="text-2xl sm:text-5xl font-extrabold text-white m-0 tracking-tight bg-gradient-to-r from-white to-accent bg-clip-text text-transparent"
            >
              NexaSnap Core API
            </h1>
          </div>
        </div>

        <p
          class="text-sm sm:text-lg text-slate-400 m-0 leading-relaxed max-w-xl sm:max-w-2xl"
        >
          High-performance REST API architecture for real-time crypto markets,
          network news, and blockchain data indexing.
        </p>

        <div
          class="bg-surface border border-border rounded-xl sm:rounded-2xl p-4 sm:p-6 flex flex-col gap-2 sm:gap-3 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.5)] mt-3 sm:mt-4"
        >
          <div class="flex items-center gap-1.5 sm:gap-2 mb-0.5 sm:mb-1">
            <div class="w-2 h-2 rounded-full bg-red-500"></div>
            <div class="w-2 h-2 rounded-full bg-amber-500"></div>
            <div
              class="w-2 h-2 rounded-full bg-accent shadow-[0_0_8px_#06b6d4]"
            >
            </div>
            <span
              class="text-slate-600 font-mono text-[0.6rem] sm:text-xs font-semibold ml-1 sm:ml-2"
              >LIVE CORE GATEWAY</span
            >
          </div>
          <div
            class="flex items-center justify-between flex-wrap gap-2 sm:gap-4"
          >
            <code
              class="text-accent-hover font-mono text-xs sm:text-base break-all"
            >
              https://muhiqsimui.github.io{base}/api/v1/
            </code>
            <span
              class="text-[0.6rem] sm:text-xs text-muted bg-surface-hover px-2 py-1 rounded border border-border font-mono"
              >STABLE ROOT</span
            >
          </div>
        </div>
      </header>

      <div class="flex flex-col gap-8 sm:gap-14">
        {
          categories.map((cat) => {
            const catDocs = getDocsByCategory(docs, cat);
            const label = categoryLabels[cat] || cat;

            return (
              <section class="category-section relative">
                <div class="flex items-center justify-between mb-4 sm:mb-6">
                  <div class="flex items-center gap-2 sm:gap-3">
                    <div class="w-1 h-4 sm:h-5 bg-accent rounded-sm shadow-[0_0_10px_#06b6d4]" />
                    <h2 class="text-base sm:text-xl font-bold text-white m-0 tracking-tight font-mono">
                      // {label}
                    </h2>
                  </div>
                  <span class="text-[0.6rem] sm:text-xs text-muted font-semibold font-mono bg-surface px-2 sm:px-3 py-1 sm:py-1.5 rounded-md border border-border">
                    {catDocs.length}{" "}
                    {catDocs.length > 1 ? "MATRICES" : "MATRIX"}
                  </span>
                </div>

                <ul class="list-none p-0 m-0 flex flex-col gap-2 sm:gap-3">
                  {catDocs.map((doc) => {
                    const isGet = doc.method?.toUpperCase() === "GET";
                    const methodColor = isGet ? "#06b6d4" : "#3b82f6";
                    const methodBg = isGet
                      ? "rgba(6, 182, 212, 0.08)"
                      : "rgba(59, 130, 246, 0.08)";
                    const methodBorder = isGet
                      ? "rgba(6, 182, 212, 0.2)"
                      : "rgba(59, 130, 246, 0.2)";

                    return (
                      <li class="m-0">
                        <a
                          href={url(base, `/docs/${doc.category}/${doc.slug}`)}
                          class="flex items-center gap-3 sm:gap-5 px-3 sm:px-6 py-2.5 sm:py-4 bg-[rgba(11,15,25,0.75)] backdrop-blur border border-border rounded-xl sm:rounded-2xl no-underline text-inherit transition-all duration-300 group hover:bg-[rgba(13,27,42,0.8)] hover:border-accent hover:shadow-[0_4px_20px_rgba(6,182,212,0.1)] hover:translate-x-1.5"
                        >
                          <span
                            class="font-mono text-[0.6rem] sm:text-xs font-bold px-1.5 sm:px-3 py-1 sm:py-1.5 rounded-md text-center tracking-wider whitespace-nowrap shrink-0"
                            style={`background: ${methodBg}; color: ${methodColor}; border: 1px solid ${methodBorder};`}
                          >
                            {doc.method}
                          </span>

                          <code class="font-mono text-xs sm:text-base text-slate-200 font-medium bg-transparent p-0 truncate min-w-0">
                            {doc.endpoint}
                          </code>

                          <span class="ml-auto text-muted text-xs transition-colors duration-200 hidden sm:flex items-center gap-2 shrink-0">
                            <span class="text-slate-400 text-xs sm:text-sm">
                              {doc.title}
                            </span>
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="10"
                              height="10"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <polyline points="9 18 15 12 9 6" />
                            </svg>
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </section>
            );
          })
        }
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  (() => {
    const canvas = document.getElementById("matrixCanvas");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    let animId;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener("resize", () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    const chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZコンニチハ";
    const numParticles = 120;
    const particles = [];

    for (let i = 0; i < numParticles; i++) {
      particles.push({
        x: Math.random() * width - width / 2,
        y: Math.random() * height - height / 2,
        z: Math.random() * 1000,
        char: chars[Math.floor(Math.random() * chars.length)],
        speed: 4 + Math.random() * 6,
      });
    }

    function draw() {
      ctx.fillStyle = "rgba(3, 7, 18, 0.15)";
      ctx.fillRect(0, 0, width, height);

      const cx = width / 2;
      const cy = height / 2;

      for (let i = 0; i < numParticles; i++) {
        const p = particles[i];
        p.z -= p.speed;

        if (p.z <= 0) {
          p.z = 1000;
          p.x = Math.random() * width - width / 2;
          p.y = Math.random() * height - height / 2;
        }

        const k = 400 / p.z;
        const px = p.x * k + cx;
        const py = p.y * k + cy;

        if (px >= 0 && px <= width && py >= 0 && py <= height) {
          const size = Math.max(k * 4, 8);
          const alpha = Math.min((1000 - p.z) / 800, 1);

          ctx.font = `bold ${size}px monospace`;
          ctx.shadowBlur = size / 2;
          ctx.shadowColor = "#00d2ff";
          ctx.fillStyle = `rgba(0, 210, 255, ${alpha})`;
          ctx.fillText(p.char, px, py);

          if (Math.random() < 0.05)
            p.char = chars[Math.floor(Math.random() * chars.length)];
        }
      }
      ctx.shadowBlur = 0;
      animId = requestAnimationFrame(draw);
    }
    animId = requestAnimationFrame(draw);

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(animId);
        window.removeEventListener("resize", () => {});
      },
      { once: true },
    );
  })();
</script>

<style>
  li a:hover .endpoint-title {
    color: #06b6d4 !important;
  }
</style>

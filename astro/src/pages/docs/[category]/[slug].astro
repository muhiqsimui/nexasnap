---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { url } from "../../../lib/url";

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const docsDir = path.resolve("../generated/docs");

  const files = fs.readdirSync(docsDir);

  return files.map((file) => {
    const doc = JSON.parse(fs.readFileSync(path.join(docsDir, file), "utf-8"));

    const apiFile = path.resolve(
      "../generated",
      doc.endpoint.replace(/^\//, ""),
    );

    const exampleResponse = JSON.parse(fs.readFileSync(apiFile, "utf-8"));

    return {
      params: {
        category: doc.category,
        slug: doc.slug,
      },
      props: {
        doc,
        exampleResponse,
      },
    };
  });
}

const { doc, exampleResponse } = Astro.props;
const categoryLabels: Record<string, string> = {
  crypto: "Cryptocurrency",
  market: "Market Data",
  news: "News",
};
const categoryLabel = categoryLabels[doc.category] || doc.category;
---

<BaseLayout title={doc.title} description={doc.description}>
  <a href={url(base, "/docs")} class="meta" style="display: inline-block; margin-bottom: 1rem;">
    &larr; Back to Docs
  </a>

  <div class="page-header">
    <div>
      <span class="meta" style="font-size: 0.85rem;">{categoryLabel}</span>
      <h1 style="margin-bottom: 0.5rem;">{doc.title}</h1>
      <p class="meta">{doc.description}</p>
    </div>
  </div>

  <section>
    <h2>Endpoint</h2>
    <div class="endpoint-card">
      <span class="badge badge-get">{doc.method}</span>
      <code>{doc.endpoint}</code>
    </div>
  </section>

  <section>
    <h2>Example Response</h2>
    <pre><code>{JSON.stringify(exampleResponse, null, 2)}</code></pre>
  </section>

  <hr />

  <section>
    <h2>Try It</h2>
    <div class="card">
      <pre><code>curl https://muhiqsimui.github.io{base}{doc.endpoint}</code></pre>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2rem;
  }

  .endpoint-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  section {
    margin-bottom: 2rem;
  }
</style>

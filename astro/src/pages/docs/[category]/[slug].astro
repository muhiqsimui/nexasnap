---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { url } from "../../../lib/url";
import { Code } from "astro:components";

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const docsDir = path.resolve("../generated/docs");
  const files = fs.readdirSync(docsDir);

  return files.map((file) => {
    const doc = JSON.parse(fs.readFileSync(path.join(docsDir, file), "utf-8"));
    const apiFile = path.resolve(
      "../generated",
      doc.endpoint.replace(/^\//, ""),
    );
    const exampleResponse = JSON.parse(fs.readFileSync(apiFile, "utf-8"));

    return {
      params: { category: doc.category, slug: doc.slug },
      props: { doc, exampleResponse },
    };
  });
}

const { doc, exampleResponse } = Astro.props;
const categoryLabels: Record<string, string> = {
  crypto: "Cryptocurrency",
  market: "Market Data",
  news: "News",
};
const categoryLabel = categoryLabels[doc.category] || doc.category;

const isGet = doc.method?.toUpperCase() === "GET";
const methodColor = isGet ? "#10b981" : "#3b82f6";
const methodBg = isGet ? "rgba(16, 185, 129, 0.1)" : "rgba(59, 130, 246, 0.1)";
const methodBorder = isGet
  ? "rgba(16, 185, 129, 0.2)"
  : "rgba(59, 130, 246, 0.2)";

const fullUrl = `https://muhiqsimui.github.io${base}${doc.endpoint.replace(/^\//, "")}`;

const snippets = {
  curl: `curl -X ${doc.method} "${fullUrl}"`,
  javascript: `fetch("${fullUrl}", {\n  method: "${doc.method}"\n})\n  .then(res => res.json())\n  .then(data => console.log(data));`,
  python: `import requests\n\nurl = "${fullUrl}"\nresponse = requests.${doc.method?.toLowerCase()}(url)\nprint(response.json())`,
  php: `<?php\n$ch = curl_init();\ncurl_setopt($ch, CURLOPT_URL, "${fullUrl}");\ncurl_setopt($ch, CURLOPT_RETURNTRANSFER, true);\ncurl_setopt($ch, CURLOPT_CUSTOMREQUEST, "${doc.method}");\n$response = curl_exec($ch);\ncurl_close($ch);\n$data = json_decode($response, true);\n?>`,
};

const jsonString = JSON.stringify(exampleResponse, null, 2);
---

<BaseLayout title={doc.title} description={doc.description}>
  <canvas
    id="matrix-canvas"
    class="fixed inset-0 w-screen h-screen -z-10 pointer-events-none bg-bg"
  ></canvas>

  <div
    class="relative z-10 max-w-5xl mx-auto px-3 sm:px-6 py-4 sm:py-8 font-sans text-slate-200 box-border"
  >
    <a
      href={url(base, "/docs")}
      class="back-link inline-flex items-center gap-2 text-slate-400 no-underline text-xs sm:text-sm font-medium mb-4 sm:mb-8 px-3 sm:px-4 py-2 bg-surface/80 border border-border rounded-full hover:text-cyan-400 hover:border-cyan-400 transition-all backdrop-blur"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Back to Docs
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-[55%_45%] gap-6 sm:gap-10">
      <div class="flex flex-col gap-6 sm:gap-10 min-w-0">
        <header class="border-b border-border pb-4 sm:pb-8 relative">
          <span
            class="font-mono text-xs sm:text-sm text-cyan-400 font-bold uppercase tracking-wider"
            >{categoryLabel}</span
          >
          <h1
            class="text-xl sm:text-4xl font-extrabold text-white my-2 sm:my-3 tracking-tight"
          >
            {doc.title}
          </h1>
          <p class="text-sm sm:text-base text-slate-400 m-0 leading-relaxed">
            {doc.description}
          </p>
        </header>

        <section>
          <h2
            class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider mb-3 sm:mb-4 flex items-center gap-2"
          >
            <span class="w-0.5 h-3 bg-cyan-400 rounded-sm"></span> HTTP Request
          </h2>

          <div
            class="relative flex items-center gap-2 sm:gap-4 p-3 sm:p-5 pr-10 sm:pr-24 bg-surface/80 backdrop-blur border border-border rounded-xl shadow-[inset_0_1px_2px_rgba(0,0,0,0.4)] flex-wrap sm:flex-nowrap"
          >
            <span
              class="font-mono text-[0.6rem] sm:text-xs font-bold px-2 sm:px-3 py-1 sm:py-1.5 rounded-md text-center tracking-wider shrink-0"
              style={`background: ${methodBg}; color: ${methodColor}; border: 1px solid ${methodBorder};`}
            >
              {doc.method}
            </span>

            <div class="overflow-x-auto w-full sm:w-auto flex-1 min-w-0">
              <code
                class="font-mono text-xs sm:text-base text-slate-200 font-semibold whitespace-nowrap"
                >{doc.endpoint}</code
              >
            </div>

            <button
              class="native-copy-trigger absolute top-1/2 -translate-y-1/2 right-2 sm:right-3 inline-flex items-center gap-1 bg-slate-800 border border-slate-600 rounded-md text-slate-300 font-sans text-[0.6rem] sm:text-xs font-semibold px-2 sm:px-2.5 py-1 cursor-pointer transition-all z-20 hover:bg-slate-700 hover:border-cyan-400 hover:text-white"
              data-raw-copy={doc.endpoint}
              title="Copy Endpoint"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path
                  d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                ></path>
              </svg>
              <span class="state-txt">Copy</span>
            </button>
            <a
              href={base + doc.endpoint}
              class="border-2 border-green-400 w-20 h-6 flex items-center justify-center text-sm rounded-2xl hover:bg-green-950"
              target="_blank">Check</a
            >
          </div>
        </section>

        <section
          class="bg-[rgba(17,24,39,0.4)] backdrop-blur border border-border rounded-xl p-4 sm:p-5"
        >
          <div
            class="flex flex-col sm:flex-row justify-between gap-2 sm:gap-4 text-xs sm:text-sm text-slate-500 font-mono"
          >
            <span>AUTHENTICATION: <span class="text-amber-500">NONE</span></span
            >
            <span
              >CONTENT-TYPE: <span class="text-emerald-500"
                >APPLICATION/JSON</span
              ></span
            >
          </div>
        </section>
      </div>

      <div class="flex flex-col gap-4 sm:gap-6 lg:sticky lg:top-8 min-w-0">
        <div
          class="relative bg-[rgba(9,13,22,0.85)] backdrop-blur border border-border rounded-2xl overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.7)] w-full"
        >
          <div class="bg-slate-900 border-b border-border p-0">
            <div class="flex gap-1 px-2 sm:px-3 pt-1.5 sm:pt-2 overflow-x-auto">
              <button
                class="tab-btn active text-[0.6rem] sm:text-xs font-semibold font-mono px-2 sm:px-3.5 py-1.5 sm:py-2 cursor-pointer bg-transparent border-none text-slate-500 hover:text-slate-200 border-b-2 border-transparent transition-all whitespace-nowrap"
                data-tab="curl">cURL</button
              >
              <button
                class="tab-btn text-[0.6rem] sm:text-xs font-semibold font-mono px-2 sm:px-3.5 py-1.5 sm:py-2 cursor-pointer bg-transparent border-none text-slate-500 hover:text-slate-200 border-b-2 border-transparent transition-all whitespace-nowrap"
                data-tab="javascript">JavaScript</button
              >
              <button
                class="tab-btn text-[0.6rem] sm:text-xs font-semibold font-mono px-2 sm:px-3.5 py-1.5 sm:py-2 cursor-pointer bg-transparent border-none text-slate-500 hover:text-slate-200 border-b-2 border-transparent transition-all whitespace-nowrap"
                data-tab="python">Python</button
              >
              <button
                class="tab-btn text-[0.6rem] sm:text-xs font-semibold font-mono px-2 sm:px-3.5 py-1.5 sm:py-2 cursor-pointer bg-transparent border-none text-slate-500 hover:text-slate-200 border-b-2 border-transparent transition-all whitespace-nowrap"
                data-tab="php">PHP</button
              >
            </div>
          </div>

          <div class="p-3 sm:p-5 overflow-x-auto bg-[rgba(7,10,18,0.9)]">
            <div
              class="tab-content active"
              id="tab-curl"
              data-raw={snippets.curl}
            >
              <Code code={snippets.curl} lang="bash" theme="github-dark" />
            </div>
            <div
              class="tab-content hidden"
              id="tab-javascript"
              data-raw={snippets.javascript}
            >
              <Code code={snippets.javascript} lang="js" theme="github-dark" />
            </div>
            <div
              class="tab-content hidden"
              id="tab-python"
              data-raw={snippets.python}
            >
              <Code code={snippets.python} lang="py" theme="github-dark" />
            </div>
            <div
              class="tab-content hidden"
              id="tab-php"
              data-raw={snippets.php}
            >
              <Code code={snippets.php} lang="php" theme="github-dark" />
            </div>
          </div>

          <button
            class="native-copy-trigger absolute top-2 sm:top-3 right-2 sm:right-3 inline-flex items-center gap-1 bg-slate-800 border border-slate-600 rounded-md text-slate-300 font-sans text-[0.6rem] sm:text-xs font-semibold px-2 sm:px-2.5 py-1 cursor-pointer transition-all z-20 hover:bg-slate-700 hover:border-cyan-400 hover:text-white"
            id="copy-request-btn"
            title="Copy Code"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
              ></path>
            </svg>
            <span class="state-txt">Copy</span>
          </button>
        </div>

        <div
          class="relative bg-[rgba(9,13,22,0.85)] backdrop-blur border border-border rounded-2xl overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.7)] w-full"
        >
          <div
            class="bg-slate-900 px-3 sm:px-5 py-2 sm:py-3 border-b border-border flex items-center justify-start gap-5"
          >
            <span
              class="text-[0.6rem] sm:text-xs font-bold text-slate-400 font-mono"
              >RESPONSE BODY</span
            >
            <span
              class="text-[0.55rem] sm:text-[0.65rem] text-emerald-500 bg-emerald-500/10 px-1.5 sm:px-2 py-0.5 rounded font-mono font-semibold mr-2 sm:mr-12"
              >200 OK</span
            >
          </div>
          <div
            class="p-3 sm:p-5 overflow-x-auto bg-[rgba(7,10,18,0.9)] max-h-60 sm:max-h-80 overflow-y-auto custom-scrollbar"
            id="json-response-pane"
            data-raw={jsonString}
          >
            <Code code={jsonString} lang="json" theme="github-dark" />
          </div>

          <button
            class="native-copy-trigger absolute top-2 sm:top-3 right-2 sm:right-3 inline-flex items-center gap-1 bg-slate-800 border border-slate-600 rounded-md text-slate-300 font-sans text-[0.6rem] sm:text-xs font-semibold px-2 sm:px-2.5 py-1 cursor-pointer transition-all z-20 hover:bg-slate-700 hover:border-cyan-400 hover:text-white"
            id="copy-json-btn"
            title="Copy JSON Response"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
              ></path>
            </svg>
            <span class="state-txt">Copy</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  (() => {
    document.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetTab = btn.getAttribute("data-tab");
        document.querySelectorAll(".tab-btn").forEach((b) => {
          b.classList.remove("active");
          b.style.color = "";
          b.style.borderBottomColor = "transparent";
          b.style.background = "transparent";
        });
        document
          .querySelectorAll(".tab-content")
          .forEach((c) => c.classList.add("hidden"));
        btn.classList.add("active");
        btn.style.color = "#00d2ff";
        btn.style.borderBottomColor = "#00d2ff";
        btn.style.background = "rgba(0, 210, 255, 0.05)";
        document.getElementById(`tab-${targetTab}`).classList.remove("hidden");
      });
    });

    document.querySelectorAll(".native-copy-trigger").forEach((btn) => {
      btn.addEventListener("click", () => {
        let textToCopy = "";
        const directText = btn.getAttribute("data-raw-copy");
        if (directText) {
          textToCopy = directText;
        } else if (btn.id === "copy-request-btn") {
          const activeTab = document.querySelector(".tab-content:not(.hidden)");
          if (activeTab) textToCopy = activeTab.getAttribute("data-raw");
        } else if (btn.id === "copy-json-btn") {
          const jsonPane = document.getElementById("json-response-pane");
          if (jsonPane) textToCopy = jsonPane.getAttribute("data-raw");
        }
        if (!textToCopy) return;
        navigator.clipboard
          .writeText(textToCopy)
          .then(() => {
            const textNode = btn.querySelector(".state-txt");
            btn.style.background = "rgba(0, 210, 255, 0.15)";
            btn.style.borderColor = "#00d2ff";
            btn.style.color = "#00d2ff";
            if (textNode) textNode.innerText = "COPIED";
            setTimeout(() => {
              btn.style.background = "";
              btn.style.borderColor = "";
              btn.style.color = "";
              if (textNode) textNode.innerText = "Copy";
            }, 2000);
          })
          .catch((err) => console.error("Err copy:", err));
      });
    });

    const canvas = document.getElementById("matrix-canvas");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    let animId;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener("resize", () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    const chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZコンニチハ";
    const numParticles = 80;
    const particles = [];

    for (let i = 0; i < numParticles; i++) {
      particles.push({
        x: Math.random() * width - width / 2,
        y: Math.random() * height - height / 2,
        z: Math.random() * 1000,
        char: chars[Math.floor(Math.random() * chars.length)],
        speed: 3 + Math.random() * 5,
      });
    }

    function draw() {
      ctx.fillStyle = "rgba(3, 7, 18, 0.15)";
      ctx.fillRect(0, 0, width, height);

      const cx = width / 2;
      const cy = height / 2;

      for (let i = 0; i < numParticles; i++) {
        const p = particles[i];
        p.z -= p.speed;
        if (p.z <= 0) {
          p.z = 1000;
          p.x = Math.random() * width - width / 2;
          p.y = Math.random() * height - height / 2;
        }

        const k = 400 / p.z;
        const px = p.x * k + cx;
        const py = p.y * k + cy;
        if (px >= 0 && px <= width && py >= 0 && py <= height) {
          const size = Math.max(k * 3, 6);
          const alpha = Math.min((1000 - p.z) / 800, 1);
          ctx.font = `bold ${size}px monospace`;
          ctx.shadowBlur = size / 2;
          ctx.shadowColor = "#00d2ff";
          ctx.fillStyle = `rgba(0, 210, 255, ${alpha})`;
          ctx.fillText(p.char, px, py);
          if (Math.random() < 0.05)
            p.char = chars[Math.floor(Math.random() * chars.length)];
        }
      }
      ctx.shadowBlur = 0;
      animId = requestAnimationFrame(draw);
    }
    animId = requestAnimationFrame(draw);

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(animId);
      },
      { once: true },
    );
  })();
</script>

<style>
  .tab-btn.active {
    color: #00d2ff !important;
    border-bottom-color: #00d2ff !important;
    background: rgba(0, 210, 255, 0.05) !important;
  }
  .native-copy-trigger.copied-success {
    background: rgba(0, 210, 255, 0.15) !important;
    border-color: #00d2ff !important;
    color: #00d2ff !important;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #1f2937;
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #374151;
  }
  .back-link:hover {
    color: #00d2ff !important;
    border-color: #00d2ff !important;
  }
</style>

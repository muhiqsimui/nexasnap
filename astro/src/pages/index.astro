---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDocs, getCategories, getDocsByCategory } from "../lib/docs";
import { url } from "../lib/url";

const docs = getDocs();
const categories = getCategories(docs);
const base = import.meta.env.BASE_URL;
const categoryLabels: Record<string, string> = {
  crypto: "Cryptocurrency",
  market: "Market Data",
  news: "News",
};
---

<BaseLayout
  title="Home"
  description="Free Static API Platform powered by Astro, Go and GitHub Pages"
>
  <div
    class="matrix-bg-container"
    style="position: relative; min-height: 100vh; overflow: hidden; background-color: #030712;"
  >
    <canvas
      id="matrixCanvas"
      style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0.5; z-index: 1;"
    ></canvas>

    <div
      style="position: relative; z-index: 2; max-width: 1000px; margin: 0 auto; padding: 3rem 1.5rem;"
    >
      <section
        class="hero-container"
        style="text-align: center; padding: 5rem 0 3rem; position: relative;"
      >
        <div
          class="fade-in-up"
          style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(6, 182, 212, 0.04); border: 1px solid rgba(56, 189, 248, 0.3); padding: 0.4rem 1rem; border-radius: 9999px; margin-bottom: 2rem; box-shadow: 0 0 15px rgba(6, 182, 212, 0.15);"
        >
          <span
            style="position: relative; display: flex; height: 8px; width: 8px;"
          >
            <span
              style="position: absolute; inline-size: 100%; block-size: 100%; border-radius: 9999px; background-color: #06b6d4; opacity: 0.75; animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;"
            ></span>
            <span
              style="position: relative; display: inline-flex; border-radius: 9999px; height: 8px; width: 8px; background-color: #06b6d4;"
            ></span>
          </span>
          <span
            style="font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; color: #22d3ee; font-weight: 600; letter-spacing: 0.08em;"
            >SYSTEM STATUS: OPERATIONAL VIA GH-ACTIONS</span
          >
        </div>

        <div
          style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 1rem;"
        >
          <img
            src={`${base}/assets/nexasnap-logo.webp`}
            alt="NexaSnap Logo Core"
            width="80"
            height="80"
            style="object-fit: contain; filter: drop-shadow(0 0 20px rgba(6, 182, 212, 0.6)); animation: float 6s ease-in-out infinite;"
            onerror="this.style.display='none'"
          />
          <h1
            class="hero-title glitch-text"
            data-text="NexaSnap"
            style="font-size: 4.5rem; font-weight: 800; letter-spacing: -0.05em; color: #ffffff; text-shadow: 0 0 25px rgba(6, 182, 212, 0.3); background: linear-gradient(135deg, #ffffff 40%, #06b6d4 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
          >
            NexaSnap
          </h1>
        </div>

        <p
          style="color: #94a3b8; font-size: 1.25rem; max-width: 650px; margin: 0 auto 3.5rem; line-height: 1.7; font-family: 'Inter', sans-serif;"
        >
          Decentralized, high-performance <span
            style="color: #22d3ee; font-weight: 600; border-bottom: 1px dashed rgba(6, 182, 212, 0.5); padding-bottom: 2px;"
            >Static API Engine</span
          >. Data compiled by Go binaries, distributed across global GitHub Edge
          Networks.
        </p>

        <div
          class="stats-grid"
          style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; max-width: 700px; margin: 0 auto 4rem;"
        >
          <div
            class="stat-card"
            style="background: rgba(11, 21, 35, 0.6); backdrop-filter: blur(4px); border: 1px solid #1f2937; padding: 1.5rem; border-radius: 14px; transition: all 0.3s ease;"
          >
            <span
              style="display: block; font-size: 2rem; font-weight: 700; color: #ffffff; font-family: 'JetBrains Mono', monospace; margin-bottom: 0.25rem;"
              >{docs.length}</span
            >
            <span
              style="font-size: 0.75rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;"
              >ENDPOINTS</span
            >
          </div>
          <div
            class="stat-card"
            style="background: rgba(11, 21, 35, 0.6); backdrop-filter: blur(4px); border: 1px solid #1f2937; padding: 1.5rem; border-radius: 14px; transition: all 0.3s ease;"
          >
            <span
              style="display: block; font-size: 2rem; font-weight: 700; color: #ffffff; font-family: 'JetBrains Mono', monospace; margin-bottom: 0.25rem;"
              >{categories.length}</span
            >
            <span
              style="font-size: 0.75rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;"
              >CATEGORIES</span
            >
          </div>
          <div
            class="stat-card-blue"
            style="background: rgba(11, 21, 35, 0.6); backdrop-filter: blur(4px); border: 1px solid rgba(6, 182, 212, 0.3); padding: 1.5rem; border-radius: 14px; transition: all 0.3s ease; box-shadow: inset 0 0 10px rgba(6, 182, 212, 0.05);"
          >
            <span
              style="display: block; font-size: 2rem; font-weight: 700; color: #22d3ee; font-family: 'JetBrains Mono', monospace; margin-bottom: 0.25rem;"
              >0 ms</span
            >
            <span
              style="font-size: 0.75rem; color: #06b6d4; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;"
              >DB OVERHEAD</span
            >
          </div>
        </div>
      </section>

      <section
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 6rem;"
      >
        <div
          class="feature-card"
          style="background: rgba(11, 15, 25, 0.7); border: 1px solid #1f2937; padding: 1.75rem; border-radius: 16px; transition: all 0.3s ease;"
        >
          <div style="color: #06b6d4; margin-bottom: 0.75rem;">
            <svg
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
            >
          </div>
          <h4
            style="font-size: 1.1rem; color: #fff; margin-bottom: 0.5rem; font-weight: 600;"
          >
            Serverless Pipeline
          </h4>
          <p style="font-size: 0.9rem; color: #64748b; line-height: 1.6;">
            No runtime active layers. Zero database crashes. Built explicitly to
            eliminate infrastructure cost limits.
          </p>
        </div>
        <div
          class="feature-card"
          style="background: rgba(11, 15, 25, 0.7); border: 1px solid #1f2937; padding: 1.75rem; border-radius: 16px; transition: all 0.3s ease;"
        >
          <div style="color: #3b82f6; margin-bottom: 0.75rem;">
            <svg
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
              ></path></svg
            >
          </div>
          <h4
            style="font-size: 1.1rem; color: #fff; margin-bottom: 0.5rem; font-weight: 600;"
          >
            Edge CDN Topology
          </h4>
          <p style="font-size: 0.9rem; color: #64748b; line-height: 1.6;">
            Every structured JSON payload compiled is replicated into GitHub's
            highly resilient global CDN network node.
          </p>
        </div>
      </section>

      <section style="margin-bottom: 6rem;">
        <h2
          style="font-size: 1.1rem; font-weight: 700; color: #ffffff; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; border-bottom: none; padding-bottom: 0; font-family: 'JetBrains Mono', monospace;"
        >
          <span
            style="width: 4px; height: 14px; background: #06b6d4; border-radius: 2px; box-shadow: 0 0 8px #06b6d4;"
          ></span> $ execute_init_test
        </h2>

        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div
            class="terminal-box"
            style="background: #05070f; border: 1px solid #1f2937; border-radius: 14px; overflow: hidden; transition: border-color 0.3s;"
          >
            <div
              style="background: #0b0f19; padding: 0.85rem 1.25rem; border-bottom: 1px solid #1f2937; display: flex; align-items: center; justify-content: space-between;"
            >
              <span
                style="font-size: 0.75rem; font-weight: 600; color: #94a3b8; font-family: 'JetBrains Mono', monospace;"
                >🚀 TEST_01 // CORE_MARKETS</span
              >
              <span
                style="font-size: 0.7rem; color: #475569; font-family: monospace;"
                >SH</span
              >
            </div>
            <div style="padding: 1.25rem; overflow-x: auto;">
              <pre
                style="margin:0; background:none; border:none; padding:0;"><code style="font-family: 'JetBrains Mono', monospace; color: #38bdf8; font-size: 0.9rem;">curl https://muhiqsimui.github.io{base}/api/v1/crypto/bitcoin.json</code></pre>
            </div>
          </div>
        </div>
      </section>

      <section style="margin-bottom: 4rem;">
        <div
          style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;"
        >
          <h2
            style="font-size: 1.1rem; font-weight: 700; color: #ffffff; text-transform: uppercase; letter-spacing: 0.1em; border-bottom: none; padding-bottom: 0; margin: 0; font-family: 'JetBrains Mono', monospace;"
          >
            Index Matrices
          </h2>
          <a
            href={url(base, "/docs")}
            class="pulse-link"
            style="font-size: 0.9rem; color: #06b6d4; font-weight: 600; display: inline-flex; align-items: center; gap: 0.3rem; transition: gap 0.2s;"
          >
            Open Shell Reference
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                points="12 5 19 12 12 19"></polyline></svg
            >
          </a>
        </div>

        <div style="display: flex; flex-direction: column; gap: 2.5rem;">
          {
            categories.map((cat) => {
              const catDocs = getDocsByCategory(docs, cat);
              const label = categoryLabels[cat] || cat;

              return (
                <div
                  style="background: rgba(11, 15, 25, 0.8); backdrop-filter: blur(4px); border: 1px solid #1f2937; border-radius: 16px; padding: 1.75rem; transition: border-color 0.3s;"
                  class="category-block"
                >
                  <h3 style="font-size: 0.9rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1.25rem; border-bottom: 1px solid #1f2937; padding-bottom: 0.75rem; font-family: 'JetBrains Mono', monospace;">
                    // {label}
                  </h3>

                  <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.65rem;">
                    {catDocs.slice(0, 3).map((doc) => (
                      <li>
                        <a
                          href={url(base, `/docs/${doc.category}/${doc.slug}`)}
                          style="display: flex; align-items: center; gap: 1.25rem; padding: 0.85rem 1.25rem; background: #05070f; border: 1px solid #1f2937; border-radius: 10px; font-size: 0.9rem; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); text-decoration: none; color: inherit;"
                          onmouseover="this.style.borderColor='#06b6d4'; this.style.background='#081521'; this.style.transform='translateX(6px)'"
                          onmouseout="this.style.borderColor='#1f2937'; this.style.background='#05070f'; this.style.transform='translateX(0)'"
                        >
                          <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; font-weight: 700; background: rgba(6, 182, 212, 0.08); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.25); padding: 0.2rem 0.5rem; border-radius: 4px; letter-spacing: 0.05em;">
                            {doc.method}
                          </span>
                          <code style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #e2e8f0; background: none; padding: 0;">
                            {doc.endpoint}
                          </code>
                          <span
                            style="margin-left: auto; color: #475569; font-size: 0.85rem; transition: color 0.2s; display: inline-flex; align-items: center;"
                            class="endpoint-title"
                          >
                            <span style="color: #94a3b8; margin-right: 4px;">
                              {doc.title}
                            </span>{" "}
                            &rarr;
                          </span>
                        </a>
                      </li>
                    ))}
                    {catDocs.length > 3 && (
                      <li style="text-align: center; margin-top: 0.75rem;">
                        <a
                          href={url(base, "/docs")}
                          style="font-size: 0.8rem; color: #475569; font-family: 'JetBrains Mono', monospace; text-decoration: underline;"
                          onmouseover="this.style.color='#06b6d4'"
                          onmouseout="this.style.color='#475569'"
                        >
                          View complete stack (+{catDocs.length - 3} matrix
                          files)
                        </a>
                      </li>
                    )}
                  </ul>
                </div>
              );
            })
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  (function () {
    const canvas = document.getElementById("matrixCanvas");
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    let animId;

    // AMAN: Hitung berdasarkan kontainer pembungkus penuh (atau window jika kontainer dinamis)
    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = Math.max(
      canvas.parentElement.scrollHeight,
      window.innerHeight,
    ));

    function resizeCanvas() {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = Math.max(
        canvas.parentElement.scrollHeight,
        window.innerHeight,
      );
    }
    window.addEventListener("resize", resizeCanvas);

    const matrixChars = "0101X9F2A7B5C3D8E0101M4K7L2PQ9RS01";
    const charsArr = matrixChars.split("");

    const maxParticles = 220; // Ditambah sedikit biar space tunnel lebih padat megah
    const particles = [];

    for (let i = 0; i < maxParticles; i++) {
      particles.push({
        x: (Math.random() - 0.5) * width,
        y: (Math.random() - 0.5) * height,
        z: Math.random() * width,
        char: charsArr[Math.floor(Math.random() * charsArr.length)],
      });
    }

    function draw3DMatrix() {
      ctx.fillStyle = "rgba(3, 7, 18, 0.22)"; // Trail fade-out diatur pas agar tidak patah-patah
      ctx.fillRect(0, 0, width, height);

      // Fokus lenyap diatur seimbang mengikuti tinggi hero
      const cx = width / 2;
      const cy = height / 4.5;

      for (let i = 0; i < maxParticles; i++) {
        const p = particles[i];
        p.z -= 4.2;

        if (p.z <= 0) {
          p.x = (Math.random() - 0.5) * width;
          p.y = (Math.random() - 0.5) * height;
          p.z = width;
          p.char = charsArr[Math.floor(Math.random() * charsArr.length)];
        }

        const k = 420 / p.z;
        const px = p.x * k + cx;
        const py = p.y * k + cy;

        if (px < 0 || px > width || py < 0 || py > height) continue;

        const size = Math.min(Math.max((1 - p.z / width) * 24, 7), 26);
        ctx.font = `${size}px monospace`;

        const alpha = 1 - p.z / width;

        if (alpha > 0.84) {
          ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;
          ctx.shadowBlur = 12;
          ctx.shadowColor = "#06b6d4";
        } else if (alpha > 0.45) {
          ctx.fillStyle = `rgba(34, 211, 238, ${alpha})`;
          ctx.shadowBlur = 0;
        } else {
          ctx.fillStyle = `rgba(8, 145, 178, ${alpha * 0.7})`;
          ctx.shadowBlur = 0;
        }

        if (Math.random() > 0.96) {
          p.char = charsArr[Math.floor(Math.random() * charsArr.length)];
        }

        ctx.fillText(p.char, px, py);
      }

      animId = requestAnimationFrame(draw3DMatrix);
    }

    animId = requestAnimationFrame(draw3DMatrix);

    // Bersihkan listener dan frame saat pindah halaman (Astro View Transitions safety)
    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(animId);
        window.removeEventListener("resize", resizeCanvas);
      },
      { once: true },
    );
  })();
</script>

<style>
  @keyframes ping {
    75%,
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(3deg);
    }
  }

  .pulse-link:hover {
    gap: 0.6rem !important;
    color: #22d3ee !important;
  }

  .stat-card:hover {
    border-color: #06b6d4 !important;
    transform: translateY(-4px);
    box-shadow: 0 10px 30px -5px rgba(6, 182, 212, 0.15);
    background: rgba(11, 21, 35, 0.9) !important;
  }

  .stat-card-blue:hover {
    border-color: #22d3ee !important;
    transform: translateY(-4px);
    box-shadow: 0 10px 30px -5px rgba(34, 211, 238, 0.2);
    background: rgba(11, 21, 35, 0.9) !important;
  }

  .feature-card:hover {
    border-color: #06b6d4 !important;
    background: rgba(17, 24, 39, 0.9) !important;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(6, 182, 212, 0.05);
  }

  .terminal-box:hover {
    border-color: #38bdf8 !important;
    box-shadow: 0 4px 20px rgba(56, 189, 248, 0.1);
  }

  .category-block:hover {
    border-color: rgba(6, 182, 212, 0.4) !important;
  }

  /* Fix: Ketika baris di-hover, teks panah kanan di halaman utama ikut menyala cyan */
  li a:hover .endpoint-title,
  li a:hover .endpoint-title span {
    color: #22d3ee !important;
  }
</style>

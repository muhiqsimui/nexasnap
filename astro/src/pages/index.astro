---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDocs, getCategories, getDocsByCategory } from "../lib/docs";
import { url } from "../lib/url";

const docs = getDocs();
const categories = getCategories(docs);
const base = import.meta.env.BASE_URL;
const categoryLabels: Record<string, string> = {
  crypto: "Cryptocurrency",
  market: "Market Data",
  news: "News",
};
---

<BaseLayout
  title="Home"
  description="Free Static API Platform powered by Astro, Go and GitHub Pages"
>
  <div class="relative min-h-screen overflow-hidden bg-bg">
    <canvas
      id="matrixCanvas"
      class="absolute inset-0 w-full h-full pointer-events-none opacity-45 z-0"
    ></canvas>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <section class="text-center pt-12 sm:pt-20 pb-8 sm:pb-12">
        <div class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full border border-[rgba(56,189,248,0.3)] bg-[rgba(6,182,212,0.04)] shadow-[0_0_15px_rgba(6,182,212,0.15)] mb-6 sm:mb-8">
          <span class="relative flex h-2 w-2">
            <span class="absolute inset-0 rounded-full bg-accent opacity-75 animate-ping-slow"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
          </span>
          <span class="text-[0.6rem] sm:text-xs font-mono text-accent-hover font-semibold tracking-widest">
            SYSTEM STATUS: OPERATIONAL VIA GH-ACTIONS
          </span>
        </div>

        <div class="flex flex-col items-center gap-3 sm:gap-4 mb-3 sm:mb-4">
          <img
            src={`${base}/assets/nexasnap-logo.webp`}
            alt="NexaSnap Logo Core"
            width="80"
            height="80"
            class="w-14 sm:w-20 h-14 sm:h-20 object-contain drop-shadow-[0_0_20px_rgba(6,182,212,0.6)] animate-float"
            onerror="this.style.display='none'"
          />
          <h1
            class="text-[2.5rem] sm:text-[4.5rem] font-extrabold tracking-tight text-white"
            style="text-shadow: 0 0 25px rgba(6,182,212,0.3); background: linear-gradient(135deg, #ffffff 40%, #06b6d4 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
          >
            NexaSnap
          </h1>
        </div>

        <p class="text-slate-400 text-sm sm:text-xl max-w-xl sm:max-w-2xl mx-auto mb-8 sm:mb-14 leading-relaxed sm:leading-relaxed px-2">
          Decentralized, high-performance
          <span class="text-accent-hover font-semibold border-b border-dashed border-accent/50 pb-0.5">
            Static API Engine
          </span>
          . Data compiled by Go binaries, distributed across global GitHub Edge Networks.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-6 max-w-lg sm:max-w-2xl mx-auto mb-10 sm:mb-16">
          <div class="stat-card bg-surface/60 backdrop-blur border border-border rounded-xl p-4 sm:p-6 transition-all duration-300">
            <span class="block text-xl sm:text-2xl font-bold text-white font-mono mb-1">{docs.length}</span>
            <span class="text-[0.65rem] sm:text-xs text-muted font-bold uppercase tracking-widest">ENDPOINTS</span>
          </div>
          <div class="stat-card bg-surface/60 backdrop-blur border border-border rounded-xl p-4 sm:p-6 transition-all duration-300">
            <span class="block text-xl sm:text-2xl font-bold text-white font-mono mb-1">{categories.length}</span>
            <span class="text-[0.65rem] sm:text-xs text-muted font-bold uppercase tracking-widest">CATEGORIES</span>
          </div>
          <div class="stat-card-blue bg-surface/60 backdrop-blur border border-accent/30 rounded-xl p-4 sm:p-6 transition-all duration-300 shadow-[inset_0_0_10px_rgba(6,182,212,0.05)]">
            <span class="block text-xl sm:text-2xl font-bold text-accent-hover font-mono mb-1">0 ms</span>
            <span class="text-[0.65rem] sm:text-xs text-accent font-bold uppercase tracking-widest">DB OVERHEAD</span>
          </div>
        </div>
      </section>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 mb-12 sm:mb-24">
        <div class="feature-card bg-[rgba(11,15,25,0.7)] border border-border rounded-2xl p-5 sm:p-7 transition-all duration-300">
          <div class="text-accent mb-3">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h4 class="text-base sm:text-lg text-white font-semibold mb-2">Serverless Pipeline</h4>
          <p class="text-sm text-muted leading-relaxed">No runtime active layers. Zero database crashes. Built explicitly to eliminate infrastructure cost limits.</p>
        </div>
        <div class="feature-card bg-[rgba(11,15,25,0.7)] border border-border rounded-2xl p-5 sm:p-7 transition-all duration-300">
          <div class="text-blue-500 mb-3">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
          </div>
          <h4 class="text-base sm:text-lg text-white font-semibold mb-2">Edge CDN Topology</h4>
          <p class="text-sm text-muted leading-relaxed">Every structured JSON payload compiled is replicated into GitHub's highly resilient global CDN network node.</p>
        </div>
      </div>

      <section class="mb-12 sm:mb-24">
        <h2 class="text-xs sm:text-sm font-bold text-white uppercase tracking-widest mb-4 sm:mb-6 flex items-center gap-3 font-mono">
          <span class="w-1 h-3 sm:h-3.5 bg-accent rounded-sm shadow-[0_0_8px_#06b6d4]"></span>
          $ execute_init_test
        </h2>

        <div class="terminal-box bg-[#05070f] border border-border rounded-2xl overflow-hidden transition-colors duration-300">
          <div class="bg-surface px-4 sm:px-5 py-3 border-b border-border flex items-center justify-between">
            <span class="text-[0.65rem] sm:text-xs font-semibold text-slate-400 font-mono">TEST_01 // CORE_MARKETS</span>
            <span class="text-[0.6rem] text-slate-600 font-mono">SH</span>
          </div>
          <div class="p-4 sm:p-5 overflow-x-auto">
            <pre class="m-0 bg-transparent border-none p-0"><code class="font-mono text-blue-crypto text-sm sm:text-base">curl https://muhiqsimui.github.io{base}/api/v1/crypto/bitcoin.json</code></pre>
          </div>
        </div>
      </section>

      <section class="mb-12 sm:mb-16">
        <div class="flex items-center justify-between mb-6 sm:mb-8">
          <h2 class="text-xs sm:text-sm font-bold text-white uppercase tracking-widest font-mono m-0">
            Index Matrices
          </h2>
          <a
            href={url(base, "/docs")}
            class="pulse-link text-sm text-accent font-semibold inline-flex items-center gap-1 transition-all duration-200"
          >
            Open Shell Reference
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <div class="flex flex-col gap-6 sm:gap-10">
          {
            categories.map((cat) => {
              const catDocs = getDocsByCategory(docs, cat);
              const label = categoryLabels[cat] || cat;

              return (
                <div class="category-block bg-[rgba(11,15,25,0.8)] backdrop-blur border border-border rounded-2xl p-5 sm:p-7 transition-colors duration-300">
                  <h3 class="text-[0.7rem] sm:text-xs font-bold text-muted uppercase tracking-widest mb-4 sm:mb-5 pb-3 border-b border-border font-mono">
                    // {label}
                  </h3>

                  <ul class="list-none p-0 m-0 flex flex-col gap-2 sm:gap-2.5">
                    {catDocs.slice(0, 3).map((doc) => (
                      <li>
                        <a
                          href={url(base, `/docs/${doc.category}/${doc.slug}`)}
                          class="flex items-center gap-3 sm:gap-5 px-3 sm:px-5 py-2.5 sm:py-3.5 bg-[#05070f] border border-border rounded-xl text-sm transition-all duration-300 no-underline group hover:border-accent hover:bg-[#081521] hover:translate-x-1.5"
                        >
                          <span class="font-mono text-[0.6rem] sm:text-xs font-bold bg-accent/10 text-accent-hover border border-accent/25 px-1.5 sm:px-2 py-0.5 sm:py-1 rounded tracking-wider whitespace-nowrap">
                            {doc.method}
                          </span>
                          <code class="font-mono text-xs sm:text-sm text-slate-200 bg-transparent p-0 min-w-0 truncate">
                            {doc.endpoint}
                          </code>
                          <span class="ml-auto text-muted text-xs sm:text-sm transition-colors duration-200 hidden sm:inline">
                            {doc.title} &rarr;
                          </span>
                        </a>
                      </li>
                    ))}
                    {catDocs.length > 3 && (
                      <li class="text-center mt-2 sm:mt-3">
                        <a
                          href={url(base, "/docs")}
                          class="text-[0.65rem] sm:text-xs text-muted font-mono underline hover:text-accent transition-colors no-underline"
                        >
                          View complete stack (+{catDocs.length - 3} matrix files)
                        </a>
                      </li>
                    )}
                  </ul>
                </div>
              );
            })
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  (() => {
    const canvas = document.getElementById("matrixCanvas");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    let animId;

    let width = canvas.width = canvas.parentElement.offsetWidth;
    let height = canvas.height = canvas.parentElement.offsetHeight;

    function resizeCanvas() {
      width = canvas.width = canvas.parentElement.offsetWidth;
      height = canvas.height = canvas.parentElement.offsetHeight;
    }
    window.addEventListener("resize", resizeCanvas);

    const chars = "0101X9F2A7B5C3D8E0101M4K7L2PQ9RS01".split("");
    const maxParticles = 180;
    const particles = [];

    for (let i = 0; i < maxParticles; i++) {
      particles.push({
        x: (Math.random() - 0.5) * width,
        y: (Math.random() - 0.5) * height,
        z: Math.random() * width,
        char: chars[Math.floor(Math.random() * chars.length)],
      });
    }

    function draw() {
      ctx.fillStyle = "rgba(3, 7, 18, 0.18)";
      ctx.fillRect(0, 0, width, height);

      const cx = width / 2;
      const cy = height / 3;

      for (let i = 0; i < maxParticles; i++) {
        const p = particles[i];
        p.z -= 4.5;

        if (p.z <= 0) {
          p.x = (Math.random() - 0.5) * width;
          p.y = (Math.random() - 0.5) * height;
          p.z = width;
          p.char = chars[Math.floor(Math.random() * chars.length)];
        }

        const k = 400 / p.z;
        const px = p.x * k + cx;
        const py = p.y * k + cy;

        if (px < 0 || px > width || py < 0 || py > height) continue;

        const size = Math.min(Math.max((1 - p.z / width) * 22, 8), 24);
        ctx.font = `${size}px monospace`;
        const alpha = 1 - p.z / width;

        if (alpha > 0.85) {
          ctx.fillStyle = `rgba(255,255,255,${alpha})`;
          ctx.shadowBlur = 12;
          ctx.shadowColor = "#38bdf8";
        } else if (alpha > 0.5) {
          ctx.fillStyle = `rgba(56,189,248,${alpha})`;
          ctx.shadowBlur = 0;
        } else {
          ctx.fillStyle = `rgba(8,145,178,${alpha})`;
          ctx.shadowBlur = 0;
        }

        if (Math.random() > 0.95) p.char = chars[Math.floor(Math.random() * chars.length)];
        ctx.fillText(p.char, px, py);
      }

      animId = requestAnimationFrame(draw);
    }

    animId = requestAnimationFrame(draw);

    document.addEventListener("astro:before-swap", () => {
      cancelAnimationFrame(animId);
      window.removeEventListener("resize", resizeCanvas);
    }, { once: true });
  })();
</script>

<style>
  .stat-card:hover {
    border-color: #06b6d4 !important;
    transform: translateY(-4px);
    box-shadow: 0 10px 30px -5px rgba(6, 182, 212, 0.15);
    background: rgba(11, 21, 35, 0.9) !important;
  }
  .stat-card-blue:hover {
    border-color: #22d3ee !important;
    transform: translateY(-4px);
    box-shadow: 0 10px 30px -5px rgba(34, 211, 238, 0.2);
    background: rgba(11, 21, 35, 0.9) !important;
  }
  .feature-card:hover {
    border-color: #06b6d4 !important;
    background: rgba(17, 24, 39, 0.9) !important;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(6, 182, 212, 0.05);
  }
  .terminal-box:hover {
    border-color: #38bdf8 !important;
    box-shadow: 0 4px 20px rgba(56, 189, 248, 0.1);
  }
  .category-block:hover {
    border-color: rgba(6, 182, 212, 0.4) !important;
  }
  .pulse-link:hover {
    gap: 0.6rem !important;
    color: #22d3ee !important;
  }
  .group:hover .endpoint-title {
    color: #22d3ee !important;
  }
</style>
